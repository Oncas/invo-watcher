# Involio account
INVO_EMAIL=you@example.com

# Gmail IMAP for auto-reading the email OTP
# 1) Enable 2-Step Verification on your Google account
# 2) Create an App Password: https://myaccount.google.com/apppasswords
#    (App = Mail, Device = Mac) → 16-char password
# 3) Paste that App Password below (NOT your normal Gmail password)
# 4) Run: invo-agent imap-check
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=xxxx xxxx xxxx xxxx
IMAP_MAILBOX=INBOX

# Runtime
DRY_RUN=true
LIVE=false
POLL_INTERVAL_SECONDS=4
POLL_JITTER_SECONDS=1
# Sizing: copy trader entrySize % when present; floor up to HL min notional.
# POSITION_PCT is only the fallback if entrySize is missing.
POSITION_PCT=5
# Cap each OPEN to this % of equity (margin), even if trader uses more.
MAX_POSITION_PCT=50
HL_MIN_ORDER_USD=10
# Temporary: let queued opens/adds send while over the address cap (11s pace).
# HL_BUDGET_ALLOW_DEFICIT=false
MIN_EQUITY_USD=5
NOTIFICATION_PAGE_SIZE=20

# Missed-close startup recovery (Involio closed offline, we still hold HL)
RECOVERY_ENABLED=true
# Parked SL is this many % of our margin (price move = this / leverage)
RECOVERY_SL_PCT=3

# Comma-separated portfolio UUIDs to copy (leave empty = all followed trade notifs)
PORTFOLIO_ALLOWLIST=

# Mac Notification Center (OPEN/UPDATE/CLOSE + errors)
# STICKY=true keeps alerts until you click Dismiss (uses alerter; auto-downloaded)
MAC_NOTIFY=true
MAC_NOTIFY_STICKY=true
MAC_NOTIFY_SOUND=
LOG_LEVEL=INFO
# LOG_DIR=~/.invo-agent/logs

# Snapshot API (VPS). Empty HUD_TOKEN disables the HTTP server.
# HUD_TOKEN=
# HUD_BIND=127.0.0.1
# HUD_PORT=8787

# Mac sidecar: poll the VPS (never set LIVE on the Mac after cutover).
# HUD_SYNC_URL=http://invo-vps:8787
# HUD_SYNC_INTERVAL_SECONDS=1

# VPS SSH (local ops only — never commit real values)
# VPS_IP=
# VPS_USER=root
# VPS_PASSWORD=

# GitHub Actions secrets (Settings → Secrets → Actions). Never commit real values.
# No Tailscale required — the runner SSHes to the public VPS IP.
# VPS_HOST=192.0.2.11
# VPS_USER=invo
# VPS_SSH_KEY=        # private key authorized for the invo user

# Paths (defaults are fine for Mac testing)
# SESSION_PATH=~/.invo-agent/session.json
# DB_PATH=~/.invo-agent/agent.db
