# Involio account
INVO_EMAIL=you@example.com

# Gmail IMAP for auto-reading the email OTP
# 1) Enable 2-Step Verification on your Google account
# 2) Create an App Password: https://myaccount.google.com/apppasswords
#    (App = Mail, Device = Mac) → 16-char password
# 3) Paste that App Password below (NOT your normal Gmail password)
# 4) Run: invo-agent imap-check
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=xxxx xxxx xxxx xxxx
IMAP_MAILBOX=INBOX

# Runtime
DRY_RUN=true
LIVE=false
POLL_INTERVAL_SECONDS=4
POSITION_PCT=5
MIN_EQUITY_USD=5
MIN_ORDER_USD=1
NOTIFICATION_PAGE_SIZE=20

# Comma-separated portfolio UUIDs to copy (leave empty = all followed trade notifs)
PORTFOLIO_ALLOWLIST=

# Mac Notification Center (OPEN/UPDATE/CLOSE + errors)
# STICKY=true keeps alerts until you click Dismiss (uses alerter; auto-downloaded)
MAC_NOTIFY=true
MAC_NOTIFY_STICKY=true
MAC_NOTIFY_SOUND=Glass
LOG_LEVEL=INFO
# LOG_DIR=~/.invo-agent/logs

# Paths (defaults are fine for Mac testing)
# SESSION_PATH=~/.invo-agent/session.json
# DB_PATH=~/.invo-agent/agent.db
