[Unit]
Description=Hourly 1m bar capture

[Timer]
# A run asks for every coin the archive names, one request each behind the
# importer's delay, so it occupies roughly five minutes whatever the cadence.
# The source keeps 1m bars for 5000 minutes — about 3.5 days — so hourly still
# leaves two orders of magnitude of margin, and the old */5 simply meant the
# unit was never idle.
OnCalendar=hourly
RandomizedDelaySec=300
# A missed window is unrecoverable once it ages past the retention edge;
# catch up on resume.
Persistent=true

[Install]
WantedBy=timers.target
